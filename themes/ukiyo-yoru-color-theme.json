  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A09A8F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D2CDBF"
      }
    },
    {
      "name": "Builtin variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#D9787F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#BDB3C6"
      }
    },
    {
      "name": "Field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field",
        "entity.other.attribute-name",
        "support.type.property-name",
        "string.unquoted.key"
      ],
      "settings": {
        "foreground": "#D9BE8C"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#B8A3D6"
      }
    },
    {
      "name": "Return and exceptions",
      "scope": [
        "keyword.control.flow.return",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.flow.throw",
        "keyword.control.throw"
      ],
      "settings": {
        "foreground": "#D9787F"
      }
    },
    {
      "name": "Import and preprocessor",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.other.import",
        "keyword.other.use",
        "keyword.control.module"
      ],
      "settings": {
        "foreground": "#D9787F"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor.optional",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#C4AE84"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.member",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8BA4C7"
      }
    },
    {
      "name": "Builtin function and constructor",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "entity.name.function.constructor",
        "new.expr entity.name.type",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "#9EC3C2"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.type.parameter",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#8FB8AA"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A3B58A"
      }
    },
    {
      "name": "Escape and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#C4AE84"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#9EC3C2"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D49BA9"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#D9A273"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#D9A273",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorator and attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "entity.other.attribute"
      ],
      "settings": {
        "foreground": "#D9A273"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "meta.tag punctuation"
      ],
      "settings": {
        "foreground": "#A3A9B8"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#B8A3D6"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#8BA4C7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D2CDBF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D2CDBF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#D2CDBF",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#BDB3C6"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#A3B58A"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9EC3C2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#9EC3C2"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#94AD7E"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#D9787F"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#C4AE84"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E0616A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#A09A8F",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#D2CDBF",
    "parameter": "#BDB3C6",
    "property": "#D9BE8C",
    "enumMember": "#D9A273",
    "function": "#8BA4C7",
    "method": "#8BA4C7",
    "macro": "#D9787F",
    "function.defaultLibrary": "#9EC3C2",
    "method.defaultLibrary": "#9EC3C2",
    "variable.defaultLibrary": "#9EC3C2",
    "variable.readonly": "#D9A273",
    "variable.readonly.local": "#D2CDBF",
    "property.readonly": "#D9BE8C",
    "selfParameter": {
      "foreground": "#D9787F",
      "italic": true
    },
    "selfKeyword": {
      "foreground": "#D9787F",
      "italic": true
    },
    "namespace": "#8FB8AA",
    "type": "#8FB8AA",
    "class": "#8FB8AA",
