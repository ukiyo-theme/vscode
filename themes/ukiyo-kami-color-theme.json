  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4B4943",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#292830"
      }
    },
    {
      "name": "Builtin variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#892D38",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#514967"
      }
    },
    {
      "name": "Field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field",
        "entity.other.attribute-name",
        "support.type.property-name",
        "string.unquoted.key"
      ],
      "settings": {
        "foreground": "#674B0F"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#523B83"
      }
    },
    {
      "name": "Return and exceptions",
      "scope": [
        "keyword.control.flow.return",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.flow.throw",
        "keyword.control.throw"
      ],
      "settings": {
        "foreground": "#892D38"
      }
    },
    {
      "name": "Import and preprocessor",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.other.import",
        "keyword.other.use",
        "keyword.control.module"
      ],
      "settings": {
        "foreground": "#892D38"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor.optional",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#604E22"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.member",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2B497A"
      }
    },
    {
      "name": "Builtin function and constructor",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "entity.name.function.constructor",
        "new.expr entity.name.type",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "#235367"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.type.parameter",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#22564D"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#36561D"
      }
    },
    {
      "name": "Escape and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#604E22"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#235367"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#7F3451"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7B4116"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#7B4116",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorator and attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "entity.other.attribute"
      ],
      "settings": {
        "foreground": "#7B4116"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "meta.tag punctuation"
      ],
      "settings": {
        "foreground": "#485064"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#523B83"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#2B497A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#292830",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#292830",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#292830",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#514967"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#36561D"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#235367",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#235367"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#34611E"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#9D2F3B"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#705210"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#981F2E"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#4B4943",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#292830",
    "parameter": "#514967",
    "property": "#674B0F",
    "enumMember": "#7B4116",
    "function": "#2B497A",
    "method": "#2B497A",
    "macro": "#892D38",
    "function.defaultLibrary": "#235367",
    "method.defaultLibrary": "#235367",
    "variable.defaultLibrary": "#235367",
    "variable.readonly": "#7B4116",
    "variable.readonly.local": "#292830",
    "property.readonly": "#674B0F",
    "selfParameter": {
      "foreground": "#892D38",
      "italic": true
    },
    "selfKeyword": {
      "foreground": "#892D38",
      "italic": true
    },
    "namespace": "#22564D",
    "type": "#22564D",
    "class": "#22564D",
    "interface": "#22564D",
    "enum": "#22564D",
    "struct": "#22564D",
    "typeParameter": "#22564D",
    "decorator": "#7B4116",
    "keyword": "#523B83",
    "comment": "#4B4943",
    "string": "#36561D",
    "number": "#7F3451",
    "operator": "#604E22",
    "lifetime": "#604E22",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
