  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ABAAA4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E2DCC5"
      }
    },
    {
      "name": "Builtin variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#E8707E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#B8B4D0"
      }
    },
    {
      "name": "Field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field",
        "entity.other.attribute-name",
        "support.type.property-name",
        "string.unquoted.key"
      ],
      "settings": {
        "foreground": "#E8C88A"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#C4A8F5"
      }
    },
    {
      "name": "Return and exceptions",
      "scope": [
        "keyword.control.flow.return",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.flow.throw",
        "keyword.control.throw"
      ],
      "settings": {
        "foreground": "#E8707E"
      }
    },
    {
      "name": "Import and preprocessor",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.other.import",
        "keyword.other.use",
        "keyword.control.module"
      ],
      "settings": {
        "foreground": "#E8707E"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor.optional",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#D6B77A"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "entity.name.function.member",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#82A8E8"
      }
    },
    {
      "name": "Builtin function and constructor",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "entity.name.function.constructor",
        "new.expr entity.name.type",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "#9ED6D8"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "entity.name.type.parameter",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#7FC4B4"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A3C97A"
      }
    },
    {
      "name": "Escape and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D6B77A"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#9ED6D8"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E08AA6"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#F2A36B"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#F2A36B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorator and attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.attribute",
        "entity.other.attribute"
      ],
      "settings": {
        "foreground": "#F2A36B"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "meta.tag punctuation"
      ],
      "settings": {
        "foreground": "#9DAACC"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#C4A8F5"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#82A8E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E2DCC5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E2DCC5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#E2DCC5",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#B8B4D0"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#A3C97A"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9ED6D8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#9ED6D8"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#8FB573"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#E8707E"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#D6B77A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F2616E"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ABAAA4",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E2DCC5",
    "parameter": "#B8B4D0",
    "property": "#E8C88A",
    "enumMember": "#F2A36B",
    "function": "#82A8E8",
    "method": "#82A8E8",
    "macro": "#E8707E",
    "function.defaultLibrary": "#9ED6D8",
    "method.defaultLibrary": "#9ED6D8",
    "variable.defaultLibrary": "#9ED6D8",
    "variable.readonly": "#F2A36B",
    "variable.readonly.local": "#E2DCC5",
    "property.readonly": "#E8C88A",
    "selfParameter": {
      "foreground": "#E8707E",
      "italic": true
    },
    "selfKeyword": {
      "foreground": "#E8707E",
      "italic": true
    },
    "namespace": "#7FC4B4",
    "type": "#7FC4B4",
    "class": "#7FC4B4",
    "interface": "#7FC4B4",
    "enum": "#7FC4B4",
    "struct": "#7FC4B4",
